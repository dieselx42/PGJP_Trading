# ---------------------------------------------------------------------------
# sol-futures-trading-bot -- example environment file
# ---------------------------------------------------------------------------
#
# Copy to `.env` on the SERVER ONLY and `chmod 600 .env`.
# NEVER commit a real `.env`. NEVER bake `.env` into the Docker image.
# CI/CD MUST NOT create, overwrite, or modify the server's `.env`.
#
# Every value below is the SAFE default. Absent or unparseable values cause
# the application to refuse to start or to refuse to transmit orders.
# There is no configuration in this file that enables live trading.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
APP_ENV=production

# ---------------------------------------------------------------------------
# TRADING MODE
#   disabled -> no broker, no orders, no simulated execution
#   mock     -> MockBroker only, simulated data + simulated order lifecycle
#   paper    -> IBKR paper session only (requires futures permission first)
#   live     -> IBKR live account (LOCKED OUT in this phase)
# ---------------------------------------------------------------------------
TRADING_MODE=mock

# ---------------------------------------------------------------------------
# SAFETY INTERLOCKS
#
# All four must be in their unsafe-for-trading position for ANY order to
# reach a broker. Changing one alone is not sufficient, by design.
#
# The application REFUSES TO START when LIVE_TRADING_ENABLED is true while
# TRADING_MODE is anything other than live. A half-armed configuration is
# an error, not a warning.
# ---------------------------------------------------------------------------
ALLOW_ORDER_TRANSMIT=false
LIVE_TRADING_ENABLED=false
KILL_SWITCH=true
SOL_FUTURES_PERMISSION_READY=false

# ---------------------------------------------------------------------------
# IB GATEWAY CONNECTION
#
# These ports MUST NOT be published to the internet, MUST NOT be routed
# through Traefik, and MUST NOT appear in a docker-compose `ports:` mapping.
# Localhost or a private (internal) Docker network only.
#
# No IBKR username/password/2FA material belongs in this file or anywhere
# else in this repository. IB Gateway owns authentication.
# ---------------------------------------------------------------------------
IB_HOST=127.0.0.1
IB_PAPER_PORT=4002
IB_LIVE_PORT=4001
IB_CLIENT_ID=10
# Separate client id used by short-lived operator commands so they never
# collide with (and disconnect) the running trading process.
IB_ADMIN_CLIENT_ID=110
IB_CONNECT_TIMEOUT_SECONDS=15

# ---------------------------------------------------------------------------
# INSTRUMENT
#
# MSL - Micro Solana Futures (default; smaller contract)
# SOL - Solana Futures
#
# DEFAULT_CONTRACT_MONTH is intentionally EMPTY. Expirations are never
# permanently hard-coded. An order can only be built against an explicitly
# selected, IBKR-qualified, dated contract. A continuous future is never
# tradeable.
# ---------------------------------------------------------------------------
DEFAULT_FUTURES_SYMBOL=MSL
DEFAULT_EXCHANGE=CME
DEFAULT_CURRENCY=USD
DEFAULT_CONTRACT_MONTH=

# ---------------------------------------------------------------------------
# RISK LIMITS
#
# 0 means "NOT CONFIGURED" which means "TRADING NOT AUTHORIZED".
# 0 NEVER means unlimited. Each unconfigured limit produces a specific
# rejection reason such as MAX_POSITION_CONTRACTS_NOT_CONFIGURED.
# ---------------------------------------------------------------------------
MAX_POSITION_CONTRACTS=0
MAX_ORDER_SIZE=0
MAX_DAILY_LOSS_USD=0
MAX_ORDERS_PER_HOUR=0
MAX_OPEN_ORDERS=0
MAX_NOTIONAL_EXPOSURE_USD=0

# ---------------------------------------------------------------------------
# MARKET DATA
#
# 0 means "NOT CONFIGURED" -> every order is rejected with
# MARKET_DATA_MAX_AGE_NOT_CONFIGURED.
# ---------------------------------------------------------------------------
MARKET_DATA_MAX_AGE_SECONDS=0
MARKET_DATA_POLL_INTERVAL_SECONDS=1.0

# ---------------------------------------------------------------------------
# STRATEGY
# ---------------------------------------------------------------------------
STRATEGY_NAME=noop
STRATEGY_ENABLED=true

# ---------------------------------------------------------------------------
# STORAGE
# ---------------------------------------------------------------------------
DATABASE_PATH=/app/data/trading.db
LOG_DIR=/app/logs
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# ---------------------------------------------------------------------------
# LOCAL HEALTH / STATUS SERVICE
#
# Bound to loopback inside the container. NOT published, NOT behind Traefik.
# Reach it with `make status` / `docker compose exec`.
# ---------------------------------------------------------------------------
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8787

# ---------------------------------------------------------------------------
# BROKER RECONNECT (exponential backoff, capped)
# ---------------------------------------------------------------------------
RECONNECT_INITIAL_SECONDS=2.0
RECONNECT_MAX_SECONDS=300.0
RECONNECT_MULTIPLIER=2.0
RECONNECT_MAX_ATTEMPTS=0

# ---------------------------------------------------------------------------
# BUILD METADATA
#
# GIT_COMMIT and BUILD_TIMESTAMP are deliberately NOT set here. They are Docker
# *build args*, baked into the image by `docker compose build`, and reported by
# /status. Setting them in this file would override the baked-in values with
# blanks at run time and the deployed version would read "unknown".
# ---------------------------------------------------------------------------
