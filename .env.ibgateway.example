# ---------------------------------------------------------------------------
# IB Gateway container environment -- THIS FILE HOLDS A BROKERAGE CREDENTIAL
# ---------------------------------------------------------------------------
#
#   cp .env.ibgateway.example .env.ibgateway
#   chmod 600 .env.ibgateway
#
# SERVER ONLY. Never commit a real one. `.gitignore` covers `.env.*`, and
# `scripts/verify_safety.sh` fails the deployment if this file is tracked by git
# or is not 0600.
#
# This file is referenced by the `ib-gateway` service ONLY. It is deliberately
# separate from the bot's `.env`, which is still checked for credential-shaped
# variables and still fails the deployment if any appear. The bot has no field
# to receive them and no code path that would use one.
#
# See SECURITY.md "Decision: IBC, and where the credential now lives" for why
# this file exists at all, given the original brief forbade it.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# IBKR LOGIN
#
# Use the PAPER username -- the one issued separately from your live login,
# beginning with `D`. Not your live/master username.
#
# Live credentials are out of scope. `TRADING_MODE` below is the *gateway's*
# own setting and switching it to `live` is a separate, explicit decision that
# also requires the bot's own TRADING_MODE, LIVE_TRADING_ENABLED and risk
# limits to change. It is not a one-line switch, by design.
# ---------------------------------------------------------------------------
TWS_USERID=
TWS_PASSWORD=

# ---------------------------------------------------------------------------
# GATEWAY MODE
#
# NAME COLLISION, READ THIS: the gateway image also calls its mode variable
# TRADING_MODE, and it means something different from the bot's.
#
#   this file       TRADING_MODE=paper   -> which IBKR account the gateway logs into
#   the bot's .env  TRADING_MODE=mock    -> whether the bot uses a broker at all
#
# They are read by different processes from different files and must not be
# confused. The bot being in `mock` while the gateway is in `paper` is the
# normal, safe combination: the gateway is authenticated and idle, and the bot
# does not dial it.
# ---------------------------------------------------------------------------
TRADING_MODE=paper

# ---------------------------------------------------------------------------
# API POSTURE
#
# READ_ONLY_API=yes makes the gateway itself refuse order submission, which is
# the outermost of four independent layers. The other three are the bot's
# ALLOW_ORDER_TRANSMIT=false, KILL_SWITCH=true, and all six risk limits at 0.
#
# Turning this to `no` is RUNBOOK step 10 and must be a deliberate change made
# alongside the others -- never on its own.
# ---------------------------------------------------------------------------
READ_ONLY_API=yes

# ---------------------------------------------------------------------------
# TWO-FACTOR AUTHENTICATION
#
# Paper logins do not prompt for 2FA. These matter only if this file is ever
# pointed at a live account, which is out of scope.
#
# `restart` re-attempts login after a 2FA timeout rather than exiting; `exit`
# stops the container. Neither can answer a 2FA prompt -- only a human can.
# ---------------------------------------------------------------------------
TWOFA_TIMEOUT_ACTION=restart
AUTO_RESTART_TIME=11:59 PM

# ---------------------------------------------------------------------------
# VNC
#
# For occasional manual intervention -- a stuck login, a dialog the gateway is
# waiting on. Published to 127.0.0.1 only and reached over an SSH tunnel:
#
#   ssh -N -L 5900:127.0.0.1:5900 root@<server>
#   then connect a viewer to localhost:5900
#
# This password protects the remote display, not your brokerage account. Set it
# to something OTHER than your IBKR password. Leaving it empty disables VNC.
# ---------------------------------------------------------------------------
VNC_SERVER_PASSWORD=

# ---------------------------------------------------------------------------
# TIMEZONE
#
# Affects the gateway's own restart scheduling. CME contracts report their
# hours in US/Central.
# ---------------------------------------------------------------------------
TZ=Etc/UTC
